#!/bin/sh
printf '%s\n' 'MRBE Linux TV 0.2.0' 'Plataforma: QEMU virt ARM64' 'Memoria:'
grep -E '^(MemTotal|MemAvailable):' /proc/meminfo
printf 'Kernel: '; uname -r
printf 'Framebuffer: '; [ -c /dev/fb0 ] && echo OK || echo NAO-DETECTADO
printf 'Entrada: '; ls /dev/input/event* 2>/dev/null | wc -l
printf 'IP: '; ip -4 addr show dev eth0 2>/dev/null | grep 'inet ' || echo 'Indisponivel'
