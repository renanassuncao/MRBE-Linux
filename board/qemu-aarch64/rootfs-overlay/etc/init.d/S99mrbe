#!/bin/sh
# SysV init: ultimo script; marca no console serial que o userspace subiu.
# A interface ja foi iniciada por S05mrbe-launcher.
case "$1" in
    start)
        echo "[MRBE] userspace pronto; versao 0.4.0"
        echo "MRBE_BOOT_OK"
        ;;
    stop|restart) ;;
    *) echo "Uso: $0 {start|stop|restart}"; exit 1 ;;
esac
exit 0
