# Drivers necessarios em tempo de boot: built-in (y), nao modules.
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y
CONFIG_EXT4_FS=y
CONFIG_VIRTIO=y
CONFIG_VIRTIO_MMIO=y
CONFIG_VIRTIO_BLK=y
CONFIG_VIRTIO_NET=y
CONFIG_VIRTIO_PCI=y
CONFIG_PCI=y
CONFIG_DRM=y
CONFIG_DRM_VIRTIO_GPU=y
CONFIG_DRM_FBDEV_EMULATION=y
CONFIG_FB=y
CONFIG_FRAMEBUFFER_CONSOLE=y
CONFIG_VT=y
CONFIG_VT_CONSOLE=y
CONFIG_INPUT=y
CONFIG_INPUT_EVDEV=y
CONFIG_VIRTIO_INPUT=y
CONFIG_SERIAL_AMBA_PL011=y
CONFIG_SERIAL_AMBA_PL011_CONSOLE=y
# Padroes do kernel que o sistema usa; fixados aqui para uma config nova
# nao perde-los: /dev/fb0, modo grafico do virtio-gpu, scripts #!/bin/sh,
# barramento PCI do virt, DHCP (AF_PACKET), syslog (AF_UNIX) e relogio.
CONFIG_PCI_HOST_GENERIC=y
CONFIG_DRM_VIRTIO_GPU_KMS=y
CONFIG_FB_DEVICE=y
CONFIG_BINFMT_SCRIPT=y
CONFIG_INET=y
CONFIG_PACKET=y
CONFIG_UNIX=y
CONFIG_RTC_CLASS=y
CONFIG_RTC_DRV_PL031=y
# Nao ativar recursos desktop (GNOME/Wayland/X11) no perfil minimo.
