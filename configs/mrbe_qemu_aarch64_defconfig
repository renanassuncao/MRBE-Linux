# MRBE Linux TV 0.4.0 | QEMU virt / AArch64 / 1 GiB
# Buildroot 2025.02.19 LTS; esta e uma plataforma virtual, NAO e uma imagem MXQ Pro.
BR2_aarch64=y
BR2_cortex_a53=y
BR2_TOOLCHAIN_BUILDROOT_MUSL=y
BR2_PACKAGE_HOST_LINUX_HEADERS_CUSTOM_6_12=y
BR2_INIT_BUSYBOX=y
# /dev vem do devtmpfs do kernel. O mdev fazia coldplug de modulos no boot:
# 2,2 s para carregar um unico modulo que nada usa.
BR2_ROOTFS_DEVICE_CREATION_DYNAMIC_DEVTMPFS=y
BR2_SYSTEM_DHCP="eth0"
BR2_TARGET_GENERIC_HOSTNAME="mrbe-linux"
BR2_TARGET_GENERIC_ISSUE="MRBE Linux TV 0.4.0 | prototype QEMU ARM64"
BR2_TARGET_GENERIC_GETTY_PORT="ttyAMA0"
BR2_ROOTFS_OVERLAY="$(BR2_EXTERNAL_MRBE_PATH)/board/qemu-aarch64/rootfs-overlay"
BR2_LINUX_KERNEL=y
BR2_LINUX_KERNEL_CUSTOM_VERSION=y
BR2_LINUX_KERNEL_CUSTOM_VERSION_VALUE="6.12.27"
BR2_LINUX_KERNEL_USE_ARCH_DEFAULT_CONFIG=y
BR2_LINUX_KERNEL_CONFIG_FRAGMENT_FILES="$(BR2_EXTERNAL_MRBE_PATH)/board/qemu-aarch64/linux.fragment"
BR2_LINUX_KERNEL_NEEDS_HOST_OPENSSL=y
BR2_LINUX_KERNEL_IMAGE=y
BR2_TARGET_ROOTFS_EXT2=y
BR2_TARGET_ROOTFS_EXT2_4=y
BR2_TARGET_ROOTFS_EXT2_SIZE="256M"
# BR2_TARGET_ROOTFS_TAR is not set
BR2_PACKAGE_BUSYBOX_CONFIG_FRAGMENT_FILES="$(BR2_EXTERNAL_MRBE_PATH)/board/qemu-aarch64/busybox.fragment"
BR2_PACKAGE_MRBE_LAUNCHER=y
# BR2_PACKAGE_HOST_QEMU is not set
